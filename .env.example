# Postgres connection (any Postgres works; on Neon use the pooled URL here)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Direct (non-pooled) connection, used for migrations. Optional.
DATABASE_URL_UNPOOLED=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the dashboard/API
BETTER_AUTH_URL=http://localhost:3000
