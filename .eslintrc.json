{
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
  "overrides": [
    {
      "files": [
        "src/core/**/*.ts",
        "src/service/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The core and the service run without Electron: go through host() in src/core/host.ts."
              }
            ],
            "patterns": [
              {
                "group": [
                  "../main/*",
                  "../main"
                ],
                "message": "The core must not depend on the Electron side."
              }
            ]
          }
        ]
      }
    }
  ]
}
